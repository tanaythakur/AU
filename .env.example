# Supabase: Project Settings -> API
# URL must look like https://<project-ref>.supabase.co  (NOT the dashboard address)
VITE_SUPABASE_URL=
# Use the anon / publishable key ONLY. Never put the service_role / secret key in any VITE_ variable:
# everything prefixed VITE_ is shipped to the browser.
VITE_SUPABASE_ANON_KEY=
